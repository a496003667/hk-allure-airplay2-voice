#!/bin/sh

# Diagnostic hook for shairport's run_this_when_volume_is_set setting.
# The desired AirPlay volume is passed as the final argument.

LOG=${HK_AP2_RUN:-/tmp/hk-ap2/run}/volume.log
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
printf '%s %s\n' "$(date +%s 2>/dev/null || echo 0)" "$*" >>"$LOG" 2>/dev/null || true
exit 0
