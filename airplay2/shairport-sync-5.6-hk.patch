+#ifdef CONFIG_AIRPLAY_2
+ssize_t rtsp_with_event_capable_conn(ssize_t (*fn)(rtsp_conn_info *conn, void *arg), void *arg) {
+  ssize_t result = -1;
+  pthread_mutex_lock(&conns_lock);
+  rtsp_conn_info *chosen = NULL;
+  int i;
+  for (i = 0; i < nconns; i++) {
+    rtsp_conn_info *candidate = conns[i];
+    if ((candidate != NULL) && (candidate->running != 0) && (candidate->airplay_type == ap_2) &&
+        (candidate->event_channel_fd > 0) &&
+        ((chosen == NULL) || (candidate->connection_number > chosen->connection_number)))
+      chosen = candidate;
+  }
+  if (chosen != NULL)
+    result = fn(chosen, arg);
+  pthread_mutex_unlock(&conns_lock);
+  return result;
+}
+#endif
