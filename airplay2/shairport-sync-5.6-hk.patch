+// Read (write == 0) or write the two channels of the fade control on the
+// output card.  Returns 0 on success.
+static int fade_control_access(int write, long values[2]) {
+  if (alsa_fade_ctrl == NULL)
+    return -1;
+  int card_number = 0;
+  if (alsa_handle != NULL) {
+    snd_pcm_info_t *info;
+    snd_pcm_info_alloca(&info);
+    if (snd_pcm_info(alsa_handle, info) == 0)
+      card_number = snd_pcm_info_get_card(info);
+  }
+  char card[32];
+  snprintf(card, sizeof(card), "hw:%d", card_number);
+  snd_ctl_t *control;
+  if (snd_ctl_open(&control, card, 0) < 0)
+    return -1;
+  snd_ctl_elem_id_t *id;
+  snd_ctl_elem_value_t *value;
+  snd_ctl_elem_id_alloca(&id);
+  snd_ctl_elem_value_alloca(&value);
+  snd_ctl_elem_id_set_interface(id, SND_CTL_ELEM_IFACE_MIXER);
+  snd_ctl_elem_id_set_name(id, alsa_fade_ctrl);
+  snd_ctl_elem_value_set_id(value, id);
+  int result = snd_ctl_elem_read(control, value);
+  if (result >= 0) {
+    if (write) {
+      snd_ctl_elem_value_set_integer(value, 0, values[0]);
+      snd_ctl_elem_value_set_integer(value, 1, values[1]);
+      result = snd_ctl_elem_write(control, value);
+    } else {
+      values[0] = snd_ctl_elem_value_get_integer(value, 0);
+      values[1] = snd_ctl_elem_value_get_integer(value, 1);
+    }
+  }
+  snd_ctl_close(control);
+  return result < 0 ? -1 : 0;
+}
+
+// Fade the output to silence before it is dropped.  Returns the previous
+// level in saved[] (or -1, -1 if nothing was changed).
+static void fade_out_before_drop(long saved[2]) {
+  saved[0] = saved[1] = -1;
+  if ((alsa_fade_ctrl == NULL) || (alsa_backend_state != abm_playing))
+    return;
+  long level[2];
+  if ((fade_control_access(0, level) == 0) && ((level[0] > 0) || (level[1] > 0))) {
+    long silent[2] = {0, 0};
+    if (fade_control_access(1, silent) == 0) {
+      saved[0] = level[0];
+      saved[1] = level[1];
+      usleep(40000); // let the DAC ramp down while the buffered audio still plays
+      debug(2, "alsa: faded \"%s\" from %ld,%ld before dropping the output.", alsa_fade_ctrl,
+            level[0], level[1]);
+    }
+  }
+}
+
+// After a flush within a session, restore the level once audio flows again.
+static void fade_restore_after_play(void) {
+  if (alsa_fade_restore[0] < 0)
+    return;
+  long level[2];
+  if ((fade_control_access(0, level) == 0) && (level[0] == 0) && (level[1] == 0))
+    fade_control_access(1, alsa_fade_restore);
+  alsa_fade_restore[0] = alsa_fade_restore[1] = -1;
+}
