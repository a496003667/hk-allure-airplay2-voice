+// Local change: when a different sender starts pairing (the user picked this
+// receiver on another device), end the current sender's session at once
+// instead of when the newcomer starts streaming.  Until then the receiver
+// advertises the old session (ReceiverSessionIsActive, the old sender's
+// group), and a Mac joining such a receiver does not take over its volume.
+// Opening the AirPlay picker only fetches /info and does not pair, so it
+// does not interrupt playback.
+static void preempt_other_sender(rtsp_conn_info *conn, const char *why) {
+  rtsp_conn_info *previous = NULL;
+  int previous_number = 0;
+  char previous_ip[INET6_ADDRSTRLEN] = "";
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  if ((principal_conn != NULL) && (principal_conn != conn) &&
+      (strcmp(principal_conn->client_ip_string, conn->client_ip_string) != 0)) {
+    previous = principal_conn;
+    previous_number = previous->connection_number;
+    strncpy(previous_ip, previous->client_ip_string, sizeof(previous_ip) - 1);
+  }
+  pthread_rwlock_unlock(&principal_conn_lock);
+  if (previous != NULL) {
+    warn("hk: connection %d from %s is doing %s; ending connection %d from %s.",
+         conn->connection_number, conn->client_ip_string, why, previous_number, previous_ip);
+    release_play_lock(previous); // no-op if it is no longer the principal
+    terminate_conn(previous_number);
+  }
+}
